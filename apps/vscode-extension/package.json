{
  "name": "autonomous-agentic-ai",
  "displayName": "Autonomous Agentic AI",
  "description": "Connect VS Code to your local Autonomous Agentic AI server",
  "version": "0.1.0",
  "publisher": "local-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:autonomousAI.openStudio",
    "onCommand:autonomousAI.openChat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autonomousAI.openStudio",
        "title": "Autonomous AI: Open Code Studio"
      },
      {
        "command": "autonomousAI.openChat",
        "title": "Autonomous AI: Open Chat"
      }
    ]
  }
}
