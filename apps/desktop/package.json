{
  "name": "autonomous-agentic-ai-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop coding environment with bundled Python API and Rust local inference gateway",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg",
    "package:linux": "electron-builder --linux AppImage",
    "test": "node --test hardware.test.cjs model-runtime.test.cjs energy.test.cjs model-license.test.cjs cross-platform.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.autonomous.agenticai",
    "productName": "Autonomous Agentic AI",
    "files": [
      "main.cjs",
      "preload.cjs",
      "setup.html",
      "package.json",
      "hardware.cjs",
      "energy.cjs",
      "model-runtime.cjs",
      "model-license.cjs"
    ],
    "extraResources": [
      {
        "from": "../../dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../security/model-policy.json",
        "to": "model-policy.json"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record a short voice prompt locally for speech-to-text. Audio is sent only to the configured loopback whisper.cpp server."
      }
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
