# Copy this file to .env; the API loads it at startup. Explicit shell
# environment variables take precedence over values in .env.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
ALLOW_COMMANDS=0
WORKSPACE_ROOT=./workspaces
DB_PATH=./database/agent.sqlite3

# Required for every /api route except /health. Use at least 24 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_ADMIN_TOKEN=

# Optional: store only the SHA-256 digest of the admin token instead of plaintext.
# AGENT_ADMIN_TOKEN_SHA256=

# Optional two-factor authentication: base32 TOTP secret (RFC 6238, SHA-1, 6 digits).
# Generate one with: python -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
AGENT_TOTP_SECRET=

# Hardened API controls
SECURITY_ENABLED=1
SECURITY_DB_PATH=./database/security.sqlite3
SECURITY_MAX_AUTH_FAILURES=5
SECURITY_AUTH_WINDOW_SECONDS=300
SECURITY_LOCKOUT_BASE_SECONDS=60
SECURITY_LOCKOUT_MAX_SECONDS=900
SECURITY_RATE_LIMIT_PER_MINUTE=300
SECURITY_AI_RATE_LIMIT_PER_MINUTE=60
SECURITY_CHAT_RATE_LIMIT_PER_MINUTE=40
SECURITY_AGENT_RATE_LIMIT_PER_MINUTE=30
SECURITY_EXECUTION_RATE_LIMIT_PER_MINUTE=20
SECURITY_INTEGRATION_RATE_LIMIT_PER_MINUTE=20
SECURITY_MAX_BODY_BYTES=2097152
# Only enable behind a reverse proxy you control.
SECURITY_TRUST_PROXY=0
# Optional extra comma-separated browser origins allowed to call the API.
SECURITY_ALLOWED_ORIGINS=

# Local semantic retrieval and retrieval-augmented chat
SEMANTIC_DIM=256
SEMANTIC_RAG=1
SEMANTIC_RAG_CHARS=6000
# Learned re-ranking contribution from local thumbs up/down feedback.
SEMANTIC_FEEDBACK_WEIGHT=0.02

# Defence-in-depth hardening (see docs/SECURITY_HARDENING.md)
HARDENING_ENABLED=1
# Reject unexpected Host headers (DNS rebinding). Add your reverse-proxy host here.
SECURITY_ALLOWED_HOSTS=
SECURITY_ENFORCE_HOST=1
# Block high-confidence injection signatures on structured fields.
SECURITY_BLOCK_SUSPICIOUS_INPUT=1
# Require Content-Length and reject chunked API writes.
SECURITY_REQUIRE_CONTENT_LENGTH=1
# Per-caller response budget and large-response audit threshold.
SECURITY_EGRESS_BYTES_PER_MINUTE=67108864
SECURITY_LARGE_RESPONSE_BYTES=4194304
# Distributed-guessing cooldown (failures are counted across all addresses).
SECURITY_GLOBAL_FAILURE_LIMIT=40
SECURITY_GLOBAL_COOLDOWN_SECONDS=30
# Number of audit rows retained; the oldest rows are removed with an anchor.
SECURITY_AUDIT_MAX_ENTRIES=20000
# Stable HMAC key for the tamper-evident audit chain. Keep this secret and set
# it explicitly so token rotation does not start a new chain.
SECURITY_AUDIT_KEY=
