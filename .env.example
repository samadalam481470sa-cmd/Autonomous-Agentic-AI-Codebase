MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
ALLOW_COMMANDS=0
WORKSPACE_ROOT=./workspaces
DB_PATH=./database/agent.sqlite3

# Required for every /api route except /health. Use at least 24 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_ADMIN_TOKEN=

# Optional: store only the SHA-256 digest of the admin token instead of plaintext.
# AGENT_ADMIN_TOKEN_SHA256=

# Optional two-factor authentication: base32 TOTP secret (RFC 6238, SHA-1, 6 digits).
# Generate one with: python -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
AGENT_TOTP_SECRET=

# Hardened API controls
SECURITY_ENABLED=1
SECURITY_DB_PATH=./database/security.sqlite3
SECURITY_MAX_AUTH_FAILURES=5
SECURITY_AUTH_WINDOW_SECONDS=300
SECURITY_LOCKOUT_BASE_SECONDS=60
SECURITY_LOCKOUT_MAX_SECONDS=900
SECURITY_RATE_LIMIT_PER_MINUTE=300
SECURITY_AI_RATE_LIMIT_PER_MINUTE=60
SECURITY_CHAT_RATE_LIMIT_PER_MINUTE=40
SECURITY_AGENT_RATE_LIMIT_PER_MINUTE=30
SECURITY_EXECUTION_RATE_LIMIT_PER_MINUTE=20
SECURITY_INTEGRATION_RATE_LIMIT_PER_MINUTE=20
SECURITY_MAX_BODY_BYTES=2097152
# Only enable behind a reverse proxy you control.
SECURITY_TRUST_PROXY=0
# Optional extra comma-separated browser origins allowed to call the API.
SECURITY_ALLOWED_ORIGINS=

# Local semantic retrieval and retrieval-augmented chat
SEMANTIC_DIM=256
SEMANTIC_RAG=1
SEMANTIC_RAG_CHARS=6000
# Learned re-ranking contribution from local thumbs up/down feedback.
SEMANTIC_FEEDBACK_WEIGHT=0.02

# Polyglot autonomous coding.
# Host toolchain execution builds/runs code with your installed compilers, so it is opt-in.
# The desktop app sets both to 1; a standalone API requires explicit approval headers instead.
AGENT_HOST_TOOLCHAIN=0
AGENT_AUTONOMY=0
# Optional local toolchain definitions added at runtime by POST /api/polyglot/register.
POLYGLOT_TOOLCHAINS_PATH=./database/toolchains.json

# Always-on local worker: runs only while this computer is powered on.
AGENT_WORKER_ENABLED=0
AGENT_WORKER_POLICY=always
AGENT_WORKER_ACTIVE_HOURS=0-24
AGENT_WORKER_MAX_GPU_TEMP_C=85
AGENT_WORKER_POLL_SECONDS=5
WORKER_DB_PATH=./database/worker.sqlite3

# Optional stricter rate limits for the new endpoint families.
SECURITY_POLYGLOT_RATE_LIMIT_PER_MINUTE=30
SECURITY_WORKER_RATE_LIMIT_PER_MINUTE=60

# Phase 0/2 agent core
EVENT_DB_PATH=./database/events.sqlite3
POLICY_AUDIT_PATH=./database/policy_audit.jsonl
WORKTREES_ROOT=
# Keep read-only tool calls enabled during streaming chat (1) or disable (0).
STREAM_TOOLS=1
