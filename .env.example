MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4.1-mini
ALLOW_COMMANDS=0
WORKSPACE_ROOT=./workspaces
DB_PATH=./database/agent.sqlite3

# Required for every /api route except /health. Use at least 24 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_ADMIN_TOKEN=

# Optional: store only the SHA-256 digest of the admin token instead of plaintext.
# AGENT_ADMIN_TOKEN_SHA256=

# Optional two-factor authentication: base32 TOTP secret (RFC 6238, SHA-1, 6 digits).
# Generate one with: python -c "import base64,os;print(base64.b32encode(os.urandom(20)).decode())"
AGENT_TOTP_SECRET=

# Hardened API controls
SECURITY_ENABLED=1
SECURITY_DB_PATH=./database/security.sqlite3
SECURITY_MAX_AUTH_FAILURES=5
SECURITY_AUTH_WINDOW_SECONDS=300
SECURITY_LOCKOUT_BASE_SECONDS=60
SECURITY_LOCKOUT_MAX_SECONDS=900
SECURITY_RATE_LIMIT_PER_MINUTE=300
SECURITY_AI_RATE_LIMIT_PER_MINUTE=60
SECURITY_CHAT_RATE_LIMIT_PER_MINUTE=40
SECURITY_AGENT_RATE_LIMIT_PER_MINUTE=30
SECURITY_EXECUTION_RATE_LIMIT_PER_MINUTE=20
SECURITY_INTEGRATION_RATE_LIMIT_PER_MINUTE=20
SECURITY_MAX_BODY_BYTES=2097152
# Only enable behind a reverse proxy you control.
SECURITY_TRUST_PROXY=0
# Optional extra comma-separated browser origins allowed to call the API.
SECURITY_ALLOWED_ORIGINS=

# Local semantic retrieval and retrieval-augmented chat
SEMANTIC_DIM=256
SEMANTIC_RAG=1
SEMANTIC_RAG_CHARS=6000
# Learned re-ranking contribution from local thumbs up/down feedback.
SEMANTIC_FEEDBACK_WEIGHT=0.02

# Continuous local learning (the local launcher enables this by default).
AETHERION_CONTINUOUS=0
AETHERION_LEARN_CAPTURE=1
AETHERION_LEARN_INTERVAL=900
AETHERION_LEARN_MIN_EXAMPLES=4
AETHERION_LEARN_MIN_GAIN=0.005
AETHERION_LEARN_MAX_GPU_TEMP=82
AETHERION_LEARN_AC_ONLY=0
AETHERION_AUTO_INDEX=1
LEARNING_STATE_PATH=./database/learning.sqlite3

# Optional GPU LoRA weight training. Leave disabled unless a local model and
# requirements-training.txt are installed and the model license is reviewed.
# Each run also needs explicit consent in the dashboard/API, 12 accepted answers,
# and a detected CUDA/ROCm/MPS device. Adapters are never auto-loaded.
AETHERION_LORA_TRAIN=0
AETHERION_LORA_MODEL_DIR=
AETHERION_LORA_MODEL_ID=
AETHERION_LORA_MODEL_LICENSE=
AETHERION_LORA_STEPS=20
AETHERION_LORA_MAX_EXAMPLES=250
AETHERION_LORA_MIN_GAIN=0.01
AETHERION_LORA_MAX_TOKENS=512
AETHERION_LORA_TARGETS=q_proj,v_proj

# Public GitHub learning (opt-in; downloads source only when requested).
# Fixed GitHub hosts, strict size/path limits, no uploads, and no automatic execution.
GITHUB_LEARNING=0
GITHUB_DB_PATH=./database/github_sources.sqlite3
# Optional read-only token for a higher GitHub API rate limit; never exposed to clients.
GITHUB_TOKEN=

# Polyglot autonomous coding.
# Host toolchain execution builds/runs code with your installed compilers, so it is opt-in.
# The desktop app sets both to 1; a standalone API requires explicit approval headers instead.
AGENT_HOST_TOOLCHAIN=0
AGENT_AUTONOMY=0
# Optional local toolchain definitions added at runtime by POST /api/polyglot/register.
POLYGLOT_TOOLCHAINS_PATH=./database/toolchains.json

# Always-on local worker: runs only while this computer is powered on.
AGENT_WORKER_ENABLED=0
AGENT_WORKER_POLICY=always
AGENT_WORKER_ACTIVE_HOURS=0-24
AGENT_WORKER_MAX_GPU_TEMP_C=85
AGENT_WORKER_POLL_SECONDS=5
WORKER_DB_PATH=./database/worker.sqlite3

# Optional stricter rate limits for the new endpoint families.
SECURITY_POLYGLOT_RATE_LIMIT_PER_MINUTE=30
SECURITY_WORKER_RATE_LIMIT_PER_MINUTE=60

# Phase 0/2 agent core
EVENT_DB_PATH=./database/events.sqlite3
POLICY_AUDIT_PATH=./database/policy_audit.jsonl
WORKTREES_ROOT=
# Keep read-only tool calls enabled during streaming chat (1) or disable (0).
STREAM_TOOLS=1

# Inline completions (CURSOR-style ghost text). Small, bounded, cancellable.
COMPLETION_MAX_TOKENS=160
COMPLETION_TIMEOUT_SECONDS=12

# Per-request model picker. The catalog is operator-controlled; a request may
# only name an id from it, so clients never supply a base URL. Optional extra
# entries, for example:
# MODEL_CATALOG=[{"id":"fast","label":"Fast","base_url":"https://api.example.com/v1","model":"fast-1","api_key_env":"FAST_API_KEY"}]
MODEL_CATALOG=
MODEL_CONTEXT_CHAR_BUDGET=24000

# MCP: operator-configured local stdio servers only; calls need explicit approval.
MCP_ENABLED=0
MCP_SERVERS_PATH=./database/mcp_servers.json
MCP_TIMEOUT_SECONDS=12

# Agent executor test runs inside the disposable worktree.
EXECUTOR_TEST_TIMEOUT=120
GIT_BASE_BRANCH=main

# Defence-in-depth hardening (see docs/SECURITY_HARDENING.md)
HARDENING_ENABLED=1
# Reject unexpected Host headers (DNS rebinding). Add your reverse-proxy host here.
SECURITY_ALLOWED_HOSTS=
SECURITY_ENFORCE_HOST=1
# Block high-confidence injection signatures on structured fields.
SECURITY_BLOCK_SUSPICIOUS_INPUT=1
# Require Content-Length and reject chunked API writes.
SECURITY_REQUIRE_CONTENT_LENGTH=1
# Per-caller response budget and large-response audit threshold.
SECURITY_EGRESS_BYTES_PER_MINUTE=67108864
SECURITY_LARGE_RESPONSE_BYTES=4194304
# Distributed-guessing cooldown (failures are counted across all addresses).
SECURITY_GLOBAL_FAILURE_LIMIT=40
SECURITY_GLOBAL_COOLDOWN_SECONDS=30
# Number of audit rows retained; the oldest rows are removed with an anchor.
SECURITY_AUDIT_MAX_ENTRIES=20000
# Stable HMAC key for the tamper-evident audit chain. Keep this secret and set
# it explicitly so token rotation does not start a new chain.
SECURITY_AUDIT_KEY=
