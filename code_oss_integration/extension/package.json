{
  "name": "agentic-local",
  "publisher": "agentic-workbench",
  "displayName": "Agentic Local AI",
  "description": "Native Code-OSS local AI chat and approved selection rewrites",
  "version": "0.3.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onView:agenticLocal.chat",
    "onView:agenticLocal.agent",
    "onCommand:agenticLocal.openAgent",
    "onCommand:agenticLocal.connect",
    "onCommand:agenticLocal.askSelection",
    "onCommand:agenticLocal.rewriteSelection"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Requires an independently running local model service and an explicitly provided admin token."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenticLocal",
          "title": "Local AI",
          "icon": "media/agent.svg"
        }
      ]
    },
    "views": {
      "agenticLocal": [
        {
          "id": "agenticLocal.chat",
          "name": "Local AI Chat"
        },
        {
          "id": "agenticLocal.agent",
          "name": "Agent Runs",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agenticLocal.connect",
        "title": "Local AI: Connect to This Computer"
      },
      {
        "command": "agenticLocal.openAgent",
        "title": "Local AI: Open Agent Runs"
      },
      {
        "command": "agenticLocal.askSelection",
        "title": "Local AI: Explain Selection"
      },
      {
        "command": "agenticLocal.rewriteSelection",
        "title": "Local AI: Rewrite Selection (Review Diff)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agenticLocal.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        },
        {
          "command": "agenticLocal.rewriteSelection",
          "when": "editorHasSelection && !editorReadonly",
          "group": "navigation@21"
        }
      ]
    },
    "configuration": {
      "title": "Agentic Local AI",
      "properties": {
        "agenticLocal.project": {
          "type": "string",
          "default": "demo",
          "description": "Project name in the local backend (letters, numbers, underscores, hyphens only)."
        },
        "agenticLocal.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Loopback FastAPI endpoint; non-loopback endpoints are deliberately rejected."
        }
      }
    }
  },
  "extensionKind": [
    "ui"
  ]
}
