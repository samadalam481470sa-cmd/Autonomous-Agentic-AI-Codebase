{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic.local/contracts/v1.json",
  "title": "Agentic Workbench contracts v1",
  "description": "Single source of truth for run, event, tool, model, approval, artifact, memory, connector and evaluation contracts. Generated language bindings must not be edited by hand.",
  "schema_version": 1,
  "$defs": {
    "Run": {
      "type": "object",
      "required": ["schema_version", "id", "project_id", "goal", "autonomy", "state", "created_at"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "project_id": {"type": "string"},
        "goal": {"type": "string"},
        "autonomy": {"type": "string", "enum": ["ask", "worktree", "sandbox"]},
        "state": {"type": "string", "enum": ["queued", "running", "blocked", "awaiting_approval", "completed", "failed", "cancelled"]},
        "worktree_path": {"type": "string"},
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "success_checks": {"type": "array", "items": {"type": "string"}},
        "limits": {"type": "object"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      }
    },
    "RunEvent": {
      "type": "object",
      "required": ["schema_version", "run_id", "sequence", "type", "actor", "created_at", "payload"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "sequence": {"type": "integer"},
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{2,64}$"},
        "actor": {"type": "string"},
        "created_at": {"type": "string"},
        "payload": {"type": "object"}
      }
    },
    "ToolCall": {
      "type": "object",
      "required": ["id", "run_id", "tool", "risk", "decision", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "tool": {"type": "string"},
        "risk": {"type": "string", "enum": ["read", "write", "command", "network", "dependency", "merge", "destructive"]},
        "decision": {"type": "string", "enum": ["allow", "deny", "require_approval"]},
        "target": {"type": "string"},
        "args": {"type": "object"},
        "result": {"type": "object"},
        "approved_by": {"type": "string"},
        "created_at": {"type": "string"}
      }
    },
    "ModelCall": {
      "type": "object",
      "required": ["id", "run_id", "model", "role", "input_tokens", "output_tokens", "duration_ms", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "model": {"type": "string"},
        "role": {"type": "string"},
        "input_tokens": {"type": "integer"},
        "output_tokens": {"type": "integer"},
        "duration_ms": {"type": "integer"},
        "created_at": {"type": "string"}
      }
    },
    "Approval": {
      "type": "object",
      "required": ["id", "run_id", "subject", "status", "payload_sha256", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "subject": {"type": "string"},
        "status": {"type": "string", "enum": ["pending", "approved", "rejected", "expired"]},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "decided_by": {"type": "string"},
        "reason": {"type": "string"},
        "created_at": {"type": "string"}
      }
    },
    "Artifact": {
      "type": "object",
      "required": ["id", "run_id", "kind", "path", "sha256", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "run_id": {"type": "string"},
        "kind": {"type": "string", "enum": ["diff", "log", "screenshot", "patch", "trace"]},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "created_at": {"type": "string"}
      }
    },
    "Memory": {
      "type": "object",
      "required": ["id", "project_id", "content", "source_run_id", "status", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "project_id": {"type": "string"},
        "content": {"type": "string"},
        "source_run_id": {"type": "string"},
        "status": {"type": "string", "enum": ["proposed", "approved", "rejected"]},
        "created_at": {"type": "string"}
      }
    },
    "Connector": {
      "type": "object",
      "required": ["id", "manifest_id", "status", "scopes", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "manifest_id": {"type": "string"},
        "status": {"type": "string", "enum": ["connected", "disconnected", "error", "pending"]},
        "scopes": {"type": "array", "items": {"type": "string"}},
        "created_at": {"type": "string"}
      }
    },
    "EvalResult": {
      "type": "object",
      "required": ["id", "version", "task_id", "passed", "cost", "duration_ms", "created_at"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"},
        "task_id": {"type": "string"},
        "passed": {"type": "boolean"},
        "cost": {"type": "number"},
        "duration_ms": {"type": "integer"},
        "created_at": {"type": "string"}
      }
    }
  }
}
