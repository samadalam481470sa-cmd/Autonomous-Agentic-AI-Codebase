{
  "name": "@autonomous-agentic-ai/ui",
  "version": "0.1.0",
  "private": true,
  "description": "First-party Axiom design tokens and icon set for Autonomous Agentic AI",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tokens": "./src/tokens.js",
    "./icons": "./src/icons.js",
    "./tokens.css": "./tokens.css",
    "./icons.svg": "./icons.svg",
    "./dist/tokens.json": "./dist/tokens.json",
    "./dist/icons.json": "./dist/icons.json"
  },
  "files": [
    "src",
    "dist",
    "tokens.css",
    "icons.svg",
    "favicon.svg",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && node --test test/icons.test.mjs test/provenance.test.mjs test/tokens.test.mjs",
    "test": "node --test test/icons.test.mjs test/provenance.test.mjs test/tokens.test.mjs"
  }
}
